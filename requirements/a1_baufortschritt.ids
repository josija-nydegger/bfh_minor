<?xml version="1.0" encoding="UTF-8"?>
<ids:ids xmlns:ids="http://standards.buildingsmart.org/IDS" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd">
  <ids:info>
    <ids:title>Baufortschritt - Soll-Installationsdatum, Montagestatus und Abnahmedatum</ids:title>
    <ids:description>Anforderung 1: InstallationDate (Soll-Datum gemäss Terminplan) vorhanden und im Format YYYY-MM-DD; IsInstalled vorhanden und IfcBoolean. Anforderung 2 (nur Format): AcceptanceDate, falls gesetzt, im Format YYYY-MM-DD. Gilt für alle 45 Bauteilklassen von IFC2X3.</ids:description>
    <ids:date>2026-11-04</ids:date>
  </ids:info>
  <ids:specifications>
    <ids:specification name="A1 InstallationDate" ifcVersion="IFC2X3" description="Soll-Datum gemäss Terminplan bei jedem Bauteil">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <xs:restriction base="xs:string">
              <xs:enumeration value="IFCBEAM"/>
              <xs:enumeration value="IFCBUILDINGELEMENTPROXY"/>
              <xs:enumeration value="IFCCOLUMN"/>
              <xs:enumeration value="IFCCOVERING"/>
              <xs:enumeration value="IFCCURTAINWALL"/>
              <xs:enumeration value="IFCDOOR"/>
              <xs:enumeration value="IFCFOOTING"/>
              <xs:enumeration value="IFCMEMBER"/>
              <xs:enumeration value="IFCPILE"/>
              <xs:enumeration value="IFCPLATE"/>
              <xs:enumeration value="IFCRAILING"/>
              <xs:enumeration value="IFCRAMP"/>
              <xs:enumeration value="IFCRAMPFLIGHT"/>
              <xs:enumeration value="IFCROOF"/>
              <xs:enumeration value="IFCSLAB"/>
              <xs:enumeration value="IFCSTAIR"/>
              <xs:enumeration value="IFCSTAIRFLIGHT"/>
              <xs:enumeration value="IFCWALL"/>
              <xs:enumeration value="IFCWALLSTANDARDCASE"/>
              <xs:enumeration value="IFCWINDOW"/>
              <xs:enumeration value="IFCBUILDINGELEMENTPART"/>
              <xs:enumeration value="IFCREINFORCINGBAR"/>
              <xs:enumeration value="IFCREINFORCINGMESH"/>
              <xs:enumeration value="IFCTENDON"/>
              <xs:enumeration value="IFCTENDONANCHOR"/>
              <xs:enumeration value="IFCDISCRETEACCESSORY"/>
              <xs:enumeration value="IFCFASTENER"/>
              <xs:enumeration value="IFCMECHANICALFASTENER"/>
              <xs:enumeration value="IFCDISTRIBUTIONELEMENT"/>
              <xs:enumeration value="IFCDISTRIBUTIONCONTROLELEMENT"/>
              <xs:enumeration value="IFCDISTRIBUTIONFLOWELEMENT"/>
              <xs:enumeration value="IFCDISTRIBUTIONCHAMBERELEMENT"/>
              <xs:enumeration value="IFCENERGYCONVERSIONDEVICE"/>
              <xs:enumeration value="IFCFLOWCONTROLLER"/>
              <xs:enumeration value="IFCFLOWFITTING"/>
              <xs:enumeration value="IFCFLOWMOVINGDEVICE"/>
              <xs:enumeration value="IFCFLOWSEGMENT"/>
              <xs:enumeration value="IFCFLOWSTORAGEDEVICE"/>
              <xs:enumeration value="IFCFLOWTERMINAL"/>
              <xs:enumeration value="IFCFLOWTREATMENTDEVICE"/>
              <xs:enumeration value="IFCELEMENTASSEMBLY"/>
              <xs:enumeration value="IFCFURNISHINGELEMENT"/>
              <xs:enumeration value="IFCTRANSPORTELEMENT"/>
              <xs:enumeration value="IFCELECTRICALELEMENT"/>
              <xs:enumeration value="IFCEQUIPMENTELEMENT"/>
            </xs:restriction>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCLABEL" cardinality="required" instructions="Soll-Datum der Installation gemäss Terminplan im Format YYYY-MM-DD; wird nach der Übergabe nicht verändert">
          <ids:propertySet><ids:simpleValue>Pset_InstallationOccurrence</ids:simpleValue></ids:propertySet>
          <ids:baseName><ids:simpleValue>InstallationDate</ids:simpleValue></ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value="[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="A1 IsInstalled" ifcVersion="IFC2X3" description="Montagestatus bei jedem Bauteil">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <xs:restriction base="xs:string">
              <xs:enumeration value="IFCBEAM"/>
              <xs:enumeration value="IFCBUILDINGELEMENTPROXY"/>
              <xs:enumeration value="IFCCOLUMN"/>
              <xs:enumeration value="IFCCOVERING"/>
              <xs:enumeration value="IFCCURTAINWALL"/>
              <xs:enumeration value="IFCDOOR"/>
              <xs:enumeration value="IFCFOOTING"/>
              <xs:enumeration value="IFCMEMBER"/>
              <xs:enumeration value="IFCPILE"/>
              <xs:enumeration value="IFCPLATE"/>
              <xs:enumeration value="IFCRAILING"/>
              <xs:enumeration value="IFCRAMP"/>
              <xs:enumeration value="IFCRAMPFLIGHT"/>
              <xs:enumeration value="IFCROOF"/>
              <xs:enumeration value="IFCSLAB"/>
              <xs:enumeration value="IFCSTAIR"/>
              <xs:enumeration value="IFCSTAIRFLIGHT"/>
              <xs:enumeration value="IFCWALL"/>
              <xs:enumeration value="IFCWALLSTANDARDCASE"/>
              <xs:enumeration value="IFCWINDOW"/>
              <xs:enumeration value="IFCBUILDINGELEMENTPART"/>
              <xs:enumeration value="IFCREINFORCINGBAR"/>
              <xs:enumeration value="IFCREINFORCINGMESH"/>
              <xs:enumeration value="IFCTENDON"/>
              <xs:enumeration value="IFCTENDONANCHOR"/>
              <xs:enumeration value="IFCDISCRETEACCESSORY"/>
              <xs:enumeration value="IFCFASTENER"/>
              <xs:enumeration value="IFCMECHANICALFASTENER"/>
              <xs:enumeration value="IFCDISTRIBUTIONELEMENT"/>
              <xs:enumeration value="IFCDISTRIBUTIONCONTROLELEMENT"/>
              <xs:enumeration value="IFCDISTRIBUTIONFLOWELEMENT"/>
              <xs:enumeration value="IFCDISTRIBUTIONCHAMBERELEMENT"/>
              <xs:enumeration value="IFCENERGYCONVERSIONDEVICE"/>
              <xs:enumeration value="IFCFLOWCONTROLLER"/>
              <xs:enumeration value="IFCFLOWFITTING"/>
              <xs:enumeration value="IFCFLOWMOVINGDEVICE"/>
              <xs:enumeration value="IFCFLOWSEGMENT"/>
              <xs:enumeration value="IFCFLOWSTORAGEDEVICE"/>
              <xs:enumeration value="IFCFLOWTERMINAL"/>
              <xs:enumeration value="IFCFLOWTREATMENTDEVICE"/>
              <xs:enumeration value="IFCELEMENTASSEMBLY"/>
              <xs:enumeration value="IFCFURNISHINGELEMENT"/>
              <xs:enumeration value="IFCTRANSPORTELEMENT"/>
              <xs:enumeration value="IFCELECTRICALELEMENT"/>
              <xs:enumeration value="IFCEQUIPMENTELEMENT"/>
            </xs:restriction>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCBOOLEAN" cardinality="required" instructions="Montagestatus: initial FALSE (Modellautor), TRUE nach Montage-Rückmeldung des Poliers">
          <ids:propertySet><ids:simpleValue>Pset_InstallationOccurrence</ids:simpleValue></ids:propertySet>
          <ids:baseName><ids:simpleValue>IsInstalled</ids:simpleValue></ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="A2 AcceptanceDate" ifcVersion="IFC2X3" description="Abnahmedatum, falls gesetzt, im Format YYYY-MM-DD">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <xs:restriction base="xs:string">
              <xs:enumeration value="IFCBEAM"/>
              <xs:enumeration value="IFCBUILDINGELEMENTPROXY"/>
              <xs:enumeration value="IFCCOLUMN"/>
              <xs:enumeration value="IFCCOVERING"/>
              <xs:enumeration value="IFCCURTAINWALL"/>
              <xs:enumeration value="IFCDOOR"/>
              <xs:enumeration value="IFCFOOTING"/>
              <xs:enumeration value="IFCMEMBER"/>
              <xs:enumeration value="IFCPILE"/>
              <xs:enumeration value="IFCPLATE"/>
              <xs:enumeration value="IFCRAILING"/>
              <xs:enumeration value="IFCRAMP"/>
              <xs:enumeration value="IFCRAMPFLIGHT"/>
              <xs:enumeration value="IFCROOF"/>
              <xs:enumeration value="IFCSLAB"/>
              <xs:enumeration value="IFCSTAIR"/>
              <xs:enumeration value="IFCSTAIRFLIGHT"/>
              <xs:enumeration value="IFCWALL"/>
              <xs:enumeration value="IFCWALLSTANDARDCASE"/>
              <xs:enumeration value="IFCWINDOW"/>
              <xs:enumeration value="IFCBUILDINGELEMENTPART"/>
              <xs:enumeration value="IFCREINFORCINGBAR"/>
              <xs:enumeration value="IFCREINFORCINGMESH"/>
              <xs:enumeration value="IFCTENDON"/>
              <xs:enumeration value="IFCTENDONANCHOR"/>
              <xs:enumeration value="IFCDISCRETEACCESSORY"/>
              <xs:enumeration value="IFCFASTENER"/>
              <xs:enumeration value="IFCMECHANICALFASTENER"/>
              <xs:enumeration value="IFCDISTRIBUTIONELEMENT"/>
              <xs:enumeration value="IFCDISTRIBUTIONCONTROLELEMENT"/>
              <xs:enumeration value="IFCDISTRIBUTIONFLOWELEMENT"/>
              <xs:enumeration value="IFCDISTRIBUTIONCHAMBERELEMENT"/>
              <xs:enumeration value="IFCENERGYCONVERSIONDEVICE"/>
              <xs:enumeration value="IFCFLOWCONTROLLER"/>
              <xs:enumeration value="IFCFLOWFITTING"/>
              <xs:enumeration value="IFCFLOWMOVINGDEVICE"/>
              <xs:enumeration value="IFCFLOWSEGMENT"/>
              <xs:enumeration value="IFCFLOWSTORAGEDEVICE"/>
              <xs:enumeration value="IFCFLOWTERMINAL"/>
              <xs:enumeration value="IFCFLOWTREATMENTDEVICE"/>
              <xs:enumeration value="IFCELEMENTASSEMBLY"/>
              <xs:enumeration value="IFCFURNISHINGELEMENT"/>
              <xs:enumeration value="IFCTRANSPORTELEMENT"/>
              <xs:enumeration value="IFCELECTRICALELEMENT"/>
              <xs:enumeration value="IFCEQUIPMENTELEMENT"/>
            </xs:restriction>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCLABEL" cardinality="optional" instructions="Abnahmedatum der Bauleitung im Format YYYY-MM-DD; leer = noch nicht abgenommen">
          <ids:propertySet><ids:simpleValue>Pset_InstallationOccurrence</ids:simpleValue></ids:propertySet>
          <ids:baseName><ids:simpleValue>AcceptanceDate</ids:simpleValue></ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value="[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:requirements>
    </ids:specification>
  </ids:specifications>
</ids:ids>
