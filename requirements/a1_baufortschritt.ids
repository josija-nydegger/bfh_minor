  <ids:info>
    <ids:title>Baufortschritt - Soll-Installationsdatum, Montagestatus und Abnahmedatum</ids:title>
    <ids:description>Anforderung 1: InstallationDate (Soll-Datum gemäss Terminplan) vorhanden und im Format YYYY-MM-DD; IsInstalled vorhanden und IfcBoolean. Anforderung 2 (nur Format): AcceptanceDate, falls gesetzt, im Format YYYY-MM-DD.</ids:description>
    <ids:date>2026-10-22</ids:date>
  </ids:info>
  <ids:specifications>
    <ids:specification name="A1 InstallationDate - IfcBeam" ifcVersion="IFC2X3">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name><ids:simpleValue>IFCBEAM</ids:simpleValue></ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements description="Generated from IDS-Light">
        <ids:property dataType="IFCLABEL" cardinality="required">
          <ids:propertySet><ids:simpleValue>Pset_InstallationOccurrence</ids:simpleValue></ids:propertySet>
          <ids:baseName><ids:simpleValue>InstallationDate</ids:simpleValue></ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value="[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:requirements>
    </ids:specification>
